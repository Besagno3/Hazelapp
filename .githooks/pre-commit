#!/bin/sh
# Pre-commit hook for Hazel Quest.
#
#  1. The doc ritual: a commit that changes app code (hazel-game/src/) must also stage
#       - a Feature Log entry   hazel-game/docs/feature-log/<YYYY-MM>.md  (this month's file)
#       - hazel-game/docs/ISSUES.md
#       - hazel-game/docs/TEST-CASES.md
#  2. CLAUDE.md stays small: a staged hazel-game/CLAUDE.md is checked by
#     .claude/hooks/check-claude-md.mjs — warns at 180 lines, blocks at 200, and blocks a
#     Feature Log entry put there instead of docs/feature-log/.
#
# See hazel-game/CLAUDE.md → Workflow. Intentional bypass (use sparingly): git commit --no-verify

staged=$(git diff --cached --name-only --diff-filter=ACMR)

if printf '%s\n' "$staged" | grep -qx 'hazel-game/CLAUDE.md'; then
  if ! node .claude/hooks/check-claude-md.mjs; then
    printf '\n\033[31m✖ Commit blocked — hazel-game/CLAUDE.md is over its budget (see above).\033[0m\n'
    printf 'Trim it as recommended, then re-commit. To bypass intentionally: git commit --no-verify\n\n'
    exit 1
  fi
fi

# Only enforce the doc ritual when app source code is part of this commit.
code_changed=$(printf '%s\n' "$staged" | grep -E '^hazel-game/src/')
[ -z "$code_changed" ] && exit 0

missing=""
printf '%s\n' "$staged" | grep -qE '^hazel-game/docs/feature-log/[0-9]{4}-[0-9]{2}\.md$' \
  || missing="$missing  - hazel-game/docs/feature-log/<YYYY-MM>.md  — add a Feature Log entry (this month's file)\n"
printf '%s\n' "$staged" | grep -qx 'hazel-game/docs/ISSUES.md' \
  || missing="$missing  - hazel-game/docs/ISSUES.md       — log bugs / shortcuts / things to revisit\n"
printf '%s\n' "$staged" | grep -qx 'hazel-game/docs/TEST-CASES.md' \
  || missing="$missing  - hazel-game/docs/TEST-CASES.md   — write test cases for the change\n"

if [ -n "$missing" ]; then
  printf '\n\033[31m✖ Commit blocked — the doc ritual was not followed.\033[0m\n'
  printf 'App code under hazel-game/src/ changed, but these docs are not staged:\n'
  printf "$missing"
  printf '\nUpdate them (see hazel-game/CLAUDE.md → Workflow, and docs/feature-log/README.md).\n'
  printf 'Then re-commit. To bypass intentionally: git commit --no-verify\n\n'
  exit 1
fi

exit 0
